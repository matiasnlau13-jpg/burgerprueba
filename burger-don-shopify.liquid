{%- comment -%}
  burgerprueba · sección para Shopify
  Pegá TODO este archivo en una sección "Custom Liquid" (Liquid personalizado)
  desde el editor de temas. Editá el menú/WhatsApp en el bloque CONFIG (abajo del todo).
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Archivo:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');
  /* ============================================================
     burgerprueba
     Editá el bloque CONFIG al final del <script>:
     número de WhatsApp, hamburguesas, precios, papas y extra de carne.
     ============================================================ */

  :root {
    /* ---- Papel (tema claro) ---- */
    --bg: #E7DECB;
    --bg-2: #F1EADA;
    --surface: #F4EEDF;
    --ink: #1A1714;
    --ink-soft: #574C3C;
    --accent: #C0201A;
    --accent-ink: #F7F1E4;
    --sun: #A87B12;
    --line: rgba(26, 23, 20, 0.32);
    --line-strong: rgba(26, 23, 20, 0.6);
    --shadow: 0 22px 50px -28px rgba(26, 23, 20, 0.55);

    --fs-h2: clamp(1.85rem, 4.2vw, 2.9rem);
    --fs-h3: 1.2rem;
    --fs-body: 1.0625rem;
    --fs-small: 0.8rem;
    --fs-ticket: 0.94rem;

    --wrap: 1120px;
    --radius: 4px;
    --nav-h: 68px;

    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0B0A09;
      --bg-2: #12100E;
      --surface: #16130F;
      --ink: #F3ECDD;
      --ink-soft: #A99C84;
      --accent: #E9381F;
      --accent-ink: #14100D;
      --sun: #E7C86B;
      --line: rgba(243, 236, 221, 0.16);
      --line-strong: rgba(243, 236, 221, 0.4);
      --shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
      color-scheme: dark;
    }
  }

  :root[data-theme="dark"] {
    --bg: #0B0A09;
    --bg-2: #12100E;
    --surface: #16130F;
    --ink: #F3ECDD;
    --ink-soft: #A99C84;
    --accent: #E9381F;
    --accent-ink: #14100D;
    --sun: #E7C86B;
    --line: rgba(243, 236, 221, 0.16);
    --line-strong: rgba(243, 236, 221, 0.4);
    --shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Archivo", "Helvetica Neue", Arial, sans-serif;
    font-size: var(--fs-body);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection { background: var(--accent); color: var(--accent-ink); }
  a { color: inherit; }
  h1, h2, h3 { text-wrap: balance; margin: 0; }

  .wrap {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
  }

  .display {
    font-family: "Alfa Slab One", Georgia, serif;
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0.005em;
  }

  .kicker {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: var(--fs-small);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* ===================== NAV ===================== */

  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
    color: #F4EDDE;
    transition: background 0.25s ease, box-shadow 0.25s ease, color 0.25s ease;
  }
  .nav.solid {
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--line-strong);
  }
  .nav__logo {
    font-family: "Alfa Slab One", serif;
    text-transform: uppercase;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  /* ===================== HERO ===================== */

  .hero {
    --h-bg: #0A0908;
    --h-ink: #F4EDDE;
    --h-sun: #EBCB6E;
    --h-accent: #EC3B22;

    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    background: var(--h-bg);
    color: var(--h-ink);
    text-align: center;
    padding: calc(var(--nav-h) + 1rem) 1.25rem 2rem;
  }

  /* burger de fondo, centrado detrás del logo (reemplazable por una foto: ver notas al pie) */
  .hero__bg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(1080px, 138vw);
    translate: -50% -50%;
    color: var(--h-sun);
    opacity: 0.22;
    filter: blur(0.4px);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent 82%);
    mask-image: radial-gradient(closest-side, #000 45%, transparent 82%);
  }
  .hero__bg svg { width: 100%; height: auto; display: block; }

  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(58% 44% at 50% 108%, rgba(236, 59, 34, 0.30), rgba(236, 59, 34, 0) 72%),
      radial-gradient(70% 55% at 50% 34%, rgba(235, 203, 110, 0.10), rgba(235, 203, 110, 0) 70%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.66) 0%, rgba(0, 0, 0, 0) 26%, rgba(0, 0, 0, 0) 58%, rgba(0, 0, 0, 0.9) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    display: grid;
    place-items: center;
    width: 100%;
  }

  .emblem { position: relative; display: grid; justify-items: center; }

  .logo-lockup {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    filter: drop-shadow(0 6px 22px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 46px rgba(235, 203, 110, 0.22));
  }
  .logo-mark { width: clamp(72px, 13vw, 108px); height: auto; color: var(--h-ink); }

  .brand {
    font-size: clamp(2rem, 9vw, 5.5rem);
    color: var(--h-ink);
    text-transform: uppercase;
  }
  .brand span { display: block; white-space: nowrap; }
  .brand__2 { color: var(--h-sun); }

  .hero__foot {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.75rem;
  }

  .hero__tagline {
    margin: 0;
    font-size: clamp(1.05rem, 3vw, 1.4rem);
    font-weight: 500;
    color: var(--h-ink);
    max-width: 26ch;
  }

  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--h-ink);
  }
  .scroll-cue__label {
    font-family: "Space Mono", monospace;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding-left: 0.3em;
  }
  .scroll-cue__btn {
    position: relative;
    width: 66px;
    height: 66px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--h-accent);
    color: #fff;
    box-shadow: 0 16px 34px -10px rgba(236, 59, 34, 0.7);
  }
  .scroll-cue__btn svg { width: 30px; height: 30px; }
  .scroll-cue__btn::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--h-accent);
  }
  .scroll-cue:hover .scroll-cue__btn { filter: brightness(1.12); }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue__btn svg { animation: bob 1.4s ease-in-out infinite; }
    .scroll-cue__btn::after { animation: pulse-ring 1.8s ease-out infinite; }
  }
  @keyframes bob {
    0%, 100% { transform: translateY(-3px); }
    50% { transform: translateY(4px); }
  }
  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.75; }
    100% { transform: scale(1.75); opacity: 0; }
  }
  @media (max-height: 720px) {
    .brand { font-size: clamp(2rem, 8vh, 4rem); }
    .hero__bg { width: min(760px, 120vw); }
    .scroll-cue__btn { width: 54px; height: 54px; }
    .scroll-cue__btn svg { width: 24px; height: 24px; }
  }

  /* ===================== ORDER: MENU + TICKET ===================== */

  .order { padding-block: clamp(3.25rem, 8vw, 5.5rem); scroll-margin-top: var(--nav-h); }

  .order__grid { display: grid; grid-template-columns: 1fr; gap: clamp(2.5rem, 5vw, 3.5rem); }
  @media (min-width: 940px) {
    .order__grid { grid-template-columns: minmax(0, 1fr) 372px; align-items: start; gap: 4rem; }
  }

  .section-head { margin-bottom: 2rem; }
  .section-head h2 {
    font-family: "Alfa Slab One", Georgia, serif;
    font-weight: 400;
    font-size: var(--fs-h2);
    text-transform: uppercase;
    margin-top: 0.4rem;
  }
  .section-head p { margin: 0.6rem 0 0; color: var(--ink-soft); max-width: 52ch; }

  /* ---- Menu board ---- */

  .menu { border-top: 2px solid var(--ink); }

  .item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .item.is-added { border-bottom-color: var(--accent); }

  .item__name {
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .item__tag {
    font-family: "Space Mono", monospace;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid currentColor;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    white-space: nowrap;
  }
  .item__desc { grid-column: 1; color: var(--ink-soft); max-width: 46ch; font-size: 0.98rem; }
  .item__incl {
    display: inline-block;
    margin-top: 0.45rem;
    font-family: "Space Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.1rem;
  }
  .item__price {
    grid-column: 2;
    grid-row: 1;
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .item__control { grid-column: 2; grid-row: 2; }

  .item__photo-wrap {
    grid-column: 1 / -1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.34s ease;
  }
  .item.show-photo .item__photo-wrap { grid-template-rows: 1fr; }
  .item__photo-inner { overflow: hidden; min-height: 0; }
  .item__photo {
    display: block;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    margin-top: 1.1rem;
    background: var(--bg-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .item__photo-wrap { transition: none; }
  }

  @media (max-width: 560px) {
    .item { grid-template-columns: 1fr; gap: 0.55rem; }
    .item__name, .item__desc, .item__price, .item__control { grid-column: 1; grid-row: auto; }
    .item__price { font-size: 1rem; color: var(--ink-soft); }
  }

  /* ---- Stepper ---- */

  .stepper {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .stepper button {
    width: 38px;
    height: 38px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 1.25rem;
    font-family: "Archivo", sans-serif;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .stepper button:hover:not(:disabled) { background: var(--accent); color: var(--accent-ink); }
  .stepper button:disabled { opacity: 0.32; cursor: not-allowed; }
  .stepper output {
    min-width: 2.4ch;
    text-align: center;
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    padding-inline: 0.3rem;
  }
  .stepper[data-active="true"] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }

  /* ---- Papas extra ---- */

  .fries {
    margin-top: 2.75rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--bg-2);
    display: grid;
    gap: 0.9rem;
  }
  .fries__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .fries h3 { font-family: "Archivo", sans-serif; font-weight: 700; font-size: var(--fs-h3); }
  .fries__price { font-family: "Space Mono", monospace; font-weight: 700; font-variant-numeric: tabular-nums; }
  .fries__note { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
  .fries__body { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 0.3rem; }

  .meat-picker { display: grid; gap: 0.55rem; margin-top: 0.2rem; }
  .meat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .meat-row:first-child { padding-top: 0; border-top: 0; }
  .meat-row > span { font-family: "Archivo", sans-serif; font-weight: 600; }
  .meat-row__n {
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-size: 0.85em;
    color: var(--accent);
    margin-left: 0.15rem;
  }
  .meat-empty { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
  .meat-row .choice label { padding: 0.42rem 0.95rem; font-size: 0.85rem; }

  .choice { display: inline-flex; border: 2px solid var(--ink); border-radius: var(--radius); overflow: hidden; }
  .choice label {
    padding: 0.55rem 1.2rem;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    background: var(--surface);
    transition: background 0.14s ease, color 0.14s ease;
  }
  .choice label + label { border-left: 2px solid var(--ink); }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice label:has(input:checked) { background: var(--accent); color: var(--accent-ink); }
  .choice label:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }

  /* ===================== TICKET / COMANDA ===================== */

  .ticket-col { position: relative; scroll-margin-top: var(--nav-h); }
  @media (min-width: 940px) { .ticket-col { position: sticky; top: calc(var(--nav-h) + 1rem); } }

  .ticket {
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: var(--fs-ticket);
    line-height: 1.5;
  }
  .ticket__head {
    padding: 1.1rem 1.25rem 0.9rem;
    border-bottom: 2px dashed var(--line-strong);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ticket__head h2 { font-family: "Space Mono", monospace; font-weight: 700; font-size: 1rem; letter-spacing: 0.14em; }
  .ticket__stamp {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    transform: rotate(4deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticket__stamp.pop { animation: stamp 0.4s ease-out; }
  }
  @keyframes stamp {
    0% { transform: rotate(4deg) scale(1); }
    35% { transform: rotate(-3deg) scale(1.16); }
    100% { transform: rotate(4deg) scale(1); }
  }

  .ticket__body { padding: 1rem 1.25rem; }
  .ticket__empty { color: var(--ink-soft); padding: 0.5rem 0 0.75rem; }

  .line {
    display: grid;
    grid-template-columns: 1.6ch 1fr auto;
    gap: 0.5rem;
    padding: 0.32rem 0;
    font-variant-numeric: tabular-nums;
  }
  .line--sub {
    grid-template-columns: 1fr auto;
    border-top: 2px dashed var(--line-strong);
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    color: var(--ink-soft);
  }
  .line--flash { background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .line__qty { color: var(--accent); font-weight: 700; }

  .ticket__pay { border-top: 2px dashed var(--line-strong); padding: 0.9rem 1.25rem; display: grid; gap: 0.6rem; border-inline: 0; border-bottom: 0; margin: 0; }
  .ticket__pay legend {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0;
  }
  .pay-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .pay-opt {
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    padding: 0.55rem 0.6rem;
    text-align: center;
    cursor: pointer;
    font-size: 0.86rem;
    background: var(--bg-2);
    transition: background 0.14s ease, color 0.14s ease;
  }
  .pay-opt:has(input:checked) { background: var(--ink); color: var(--bg); }
  .pay-opt:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .pay-opt input { position: absolute; opacity: 0; }
  .pay-note { font-size: 0.78rem; color: var(--ink-soft); min-height: 1.1em; }
  .pay-note b { color: var(--ink); }

  .ticket__total {
    border-top: 2px solid var(--ink);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .ticket__total span { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .ticket__total b {
    font-family: "Alfa Slab One", serif;
    font-weight: 400;
    font-size: 1.7rem;
    font-variant-numeric: tabular-nums;
  }

  .ticket__foot { padding: 0 1.25rem 1.25rem; }
  .wa-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.95rem 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .wa-btn svg { width: 20px; height: 20px; }
  .wa-btn:hover { transform: translateY(-2px); }
  .wa-btn[aria-disabled="true"] {
    background: var(--bg-2);
    color: var(--ink-soft);
    border-color: var(--line-strong);
    cursor: not-allowed;
    transform: none;
  }
  .wa-hint { margin: 0.55rem 0 0; font-family: "Space Mono", monospace; font-size: 0.72rem; color: var(--ink-soft); text-align: center; }

  /* ---- Barra mobile ---- */

  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem clamp(1rem, 4vw, 1.5rem);
    background: var(--surface);
    border-top: 2px solid var(--ink);
    font-family: "Space Mono", monospace;
  }
  .mobile-bar strong { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
  .mobile-bar small { display: block; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
  .mobile-bar a {
    background: var(--accent);
    color: var(--accent-ink);
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    text-decoration: none;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius);
    border: 2px solid var(--ink);
  }
  .mobile-bar.show { display: flex; }
  @media (min-width: 940px) { .mobile-bar { display: none !important; } }
  body.has-bar { padding-bottom: 78px; }
  @media (min-width: 940px) { body.has-bar { padding-bottom: 0; } }

  /* ===================== FOOTER ===================== */

  .foot { border-top: 2px solid var(--ink); background: var(--bg-2); padding-block: clamp(2.5rem, 6vw, 4rem); scroll-margin-top: var(--nav-h); }
  .foot__grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .foot h3 {
    font-family: "Space Mono", monospace;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
