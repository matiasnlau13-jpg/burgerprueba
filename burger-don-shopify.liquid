<script>
  /* ============================================================
     CONFIGURACIÓN — editá solo esto
     ============================================================ */
  const CONFIG = {
    // WhatsApp con código de país, sin + ni espacios. Ej Argentina: 549 + área + número.
    whatsapp: "5491124564499",

    // Las 5 hamburguesas. Todas incluyen papas (se aclara solo en la web).
    // "photo": pegá acá el data URI de la foto de cada una (te lo armo yo con las fotos reales).
    //          Si queda "" se usa una ilustración de ejemplo.
    burgers: [
      { id: "clasica", name: "La Clásica",  tag: "",              price: 7200, photo: "", desc: "Medallón smash, cheddar, cebolla, pepino y salsa de la casa en pan de papa." },
      { id: "doble",   name: "Doble Don",   tag: "La más pedida", price: 9800, photo: "", desc: "Doble medallón, doble cheddar, panceta crocante y cebolla caramelizada." },
      { id: "criolla", name: "La Criolla",  tag: "",              price: 8600, photo: "", desc: "Medallón, cheddar, huevo frito, jamón, lechuga y tomate." },
      { id: "azul",    name: "Doña Azul",   tag: "",              price: 9200, photo: "", desc: "Medallón, queso azul, rúcula y cebolla morada al verdeo." },
      { id: "brava",   name: "La Brava",    tag: "Picante",       price: 8400, photo: "", desc: "Medallón, cheddar, jalapeños, cebolla crispy y salsa chipotle." },
    ],

    // Extra: agregar cheddar y bacon a las papas que ya vienen con las hamburguesas.
    friesLoaded: {
      name: "Cheddar y bacon en las papas",
      price: 4800,
    },

    // Extra: un medallón más, en la hamburguesa que el cliente elija.
    extraCarne: {
      name: "Extra carne",
      price: 2500,
    },
  };

  /* Ilustración de ejemplo para las hamburguesas sin foto cargada. */
  const DEFAULT_PHOTO =
    "data:image/svg+xml;charset=utf-8," +
    encodeURIComponent(
      "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 250'>" +
        "<rect width='400' height='250' fill='#241c16'/>" +
        "<ellipse cx='200' cy='226' rx='138' ry='13' fill='#000' opacity='.4'/>" +
        "<ellipse cx='200' cy='206' rx='132' ry='22' fill='#c9955a'/>" +
        "<ellipse cx='200' cy='182' rx='128' ry='24' fill='#4a2c1c'/>" +
        "<path d='M74 150c22 8 40 28 46 12s24 10 30-6 22 14 30-2 22 12 30-4 22 10 30-6 24 22 40-10c-8 26-40 34-118 34s-118-12-118-52z' fill='#f2b23c'/>" +
        "<path d='M78 138c20-10 34 8 52-2s30 8 46-2 34 8 50-2c-10 20-46 26-98 26s-88-6-98-18z' fill='#cf3f2e'/>" +
        "<path d='M70 128c18 16 40 16 58-2s40 16 58-2 40 16 58-2 34 10 44 0c-10 18-52 24-108 24S80 148 70 128z' fill='#79a63a'/>" +
        "<path d='M64 116a138 82 0 0 1 272 0c0 10-61 18-136 18S64 126 64 116z' fill='#dd9b4f'/>" +
        "<ellipse cx='150' cy='84' rx='7' ry='4' fill='#f4e2b6'/>" +
        "<ellipse cx='200' cy='72' rx='7' ry='4' fill='#f4e2b6'/>" +
        "<ellipse cx='252' cy='86' rx='7' ry='4' fill='#f4e2b6'/>" +
        "<ellipse cx='180' cy='102' rx='7' ry='4' fill='#f4e2b6'/>" +
        "<ellipse cx='232' cy='104' rx='7' ry='4' fill='#f4e2b6'/>" +
        "<text x='200' y='240' text-anchor='middle' font-family='monospace' font-size='11' fill='#8a7a68'>foto de ejemplo</text>" +
      "</svg>"
    );

  /* ============================================================
     Lógica
     ============================================================ */

  const money = (n) => "$" + n.toLocaleString("es-AR");
  const $ = (s, r = document) => r.querySelector(s);
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const state = {
    qty: Object.fromEntries(CONFIG.burgers.map((b) => [b.id, 0])),
    friesOn: false,
    cheddarBacon: {},
    extraCarne: {},
    meatOn: false,
    pay: "efectivo",
  };

  try {
    const saved = JSON.parse(localStorage.getItem("burgerdon.order.v4") || "null");
    if (saved && saved.qty) {
      CONFIG.burgers.forEach((b) => { if (Number.isFinite(saved.qty[b.id])) state.qty[b.id] = saved.qty[b.id]; });
      if (["efectivo", "transferencia"].includes(saved.pay)) state.pay = saved.pay;
      if (saved.cheddarBacon && typeof saved.cheddarBacon === "object") {
        CONFIG.burgers.forEach((b) => {
          const arr = saved.cheddarBacon[b.id];
          if (Array.isArray(arr) && state.qty[b.id] > 0) {
            state.cheddarBacon[b.id] = arr.slice(0, state.qty[b.id]).map((v) => !!v);
          }
        });
      }
      const hasCB = Object.values(state.cheddarBacon).some((a) => Array.isArray(a) && a.some(Boolean));
      state.friesOn = !!saved.friesOn || hasCB;
      if (saved.extraCarne && typeof saved.extraCarne === "object") {
        CONFIG.burgers.forEach((b) => {
          const arr = saved.extraCarne[b.id];
          if (Array.isArray(arr) && state.qty[b.id] > 0) {
            state.extraCarne[b.id] = arr
              .slice(0, state.qty[b.id])
              .map((n) => Math.max(0, Math.min(50, Number(n) || 0)));
          }
        });
      }
      const hasMeat = Object.values(state.extraCarne).some((a) => Array.isArray(a) && a.some((n) => n > 0));
      state.meatOn = !!saved.meatOn || hasMeat;
    }
  } catch (e) {}

  const persist = () => { try { localStorage.setItem("burgerdon.order.v4", JSON.stringify(state)); } catch (e) {} };

  /* ---- Nav sólido al hacer scroll ---- */
  const nav = $("#nav");
  const onScroll = () => nav.classList.toggle("solid", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* ---- Menú ---- */
  const menuEl = $("#menu");
  menuEl.innerHTML = CONFIG.burgers.map((b) => `
    <article class="item" data-item="${b.id}">
      <h3 class="item__name">${b.name}${b.tag ? `<span class="item__tag">${b.tag}</span>` : ""}</h3>
      <div class="item__desc">${b.desc}<br /><span class="item__incl">Incluye papas</span></div>
      <p class="item__price">${money(b.price)}</p>
      <div class="item__control">
        <div class="stepper" data-stepper="${b.id}">
          <button type="button" data-step="-1" aria-label="Quitar una ${b.name}">−</button>
          <output aria-live="polite">0</output>
          <button type="button" data-step="1" aria-label="Agregar una ${b.name}">+</button>
        </div>
      </div>
      <div class="item__photo-wrap">
        <div class="item__photo-inner">
          <img class="item__photo" loading="lazy" alt="Foto de ${b.name}" src="${b.photo || DEFAULT_PHOTO}" />
        </div>
      </div>
    </article>
  `).join("");

  const friesUnit = () => CONFIG.friesLoaded.price;
  const meatUnit = () => CONFIG.extraCarne.price;
  const burgerCount = () => CONFIG.burgers.reduce((s, b) => s + state.qty[b.id], 0);

  // Helpers que mantienen un valor por CADA unidad pedida de una hamburguesa.
  function unitArr(store, id, fill) {
    const q = state.qty[id];
    let a = Array.isArray(store[id]) ? store[id] : [];
    if (a.length < q) a = a.concat(Array(q - a.length).fill(fill));
    if (a.length > q) a = a.slice(0, q);
    store[id] = a;
    return a;
  }
  const meatArr = (id) => unitArr(state.extraCarne, id, 0);
  const cbArr = (id) => unitArr(state.cheddarBacon, id, false);

  const meatCount = () =>
    CONFIG.burgers.reduce((s, b) => {
      const a = state.extraCarne[b.id];
      return s + (Array.isArray(a) ? a.reduce((x, n) => x + n, 0) : 0);
    }, 0);
  const friesCount = () =>
    CONFIG.burgers.reduce((s, b) => {
      const a = state.cheddarBacon[b.id];
      return s + (Array.isArray(a) ? a.filter(Boolean).length : 0);
    }, 0);

  const total = () =>
    CONFIG.burgers.reduce((s, b) => s + state.qty[b.id] * b.price, 0) +
    friesCount() * friesUnit() +
    meatCount() * meatUnit();

  let flashId = null;

  function setBurger(id, delta) {
    const next = Math.min(20, Math.max(0, state.qty[id] + delta));
    if (next === state.qty[id]) return;
    state.qty[id] = next;
    // Ajustar los extras por unidad al nuevo número de unidades de esa hamburguesa.
    [state.extraCarne, state.cheddarBacon].forEach((store) => {
      if (Array.isArray(store[id])) {
        if (next === 0) delete store[id];
        else store[id] = store[id].slice(0, next);
      }
    });
    if (delta > 0) { flashId = id; popStamp(); }
    render();
  }

  function setMeat(id, idx, delta) {
    const a = meatArr(id);
    if (idx < 0 || idx >= a.length) return;
    const next = Math.max(0, Math.min(50, a[idx] + delta));
    if (next === a[idx]) return;
    a[idx] = next;
    if (delta > 0) { flashId = "meat-" + id + "-" + idx; popStamp(); }
    render();
  }

  function setCB(id, idx, val) {
    const a = cbArr(id);
    if (idx < 0 || idx >= a.length || a[idx] === val) return;
    a[idx] = val;
    if (val) { flashId = "cb-" + id + "-" + idx; popStamp(); }
    render();
  }
  function popStamp() {
    if (reduceMotion) return;
    const st = $("#stamp");
    st.classList.remove("pop");
    void st.offsetWidth;
    st.classList.add("pop");
  }

  menuEl.addEventListener("click", (e) => {
    const btn = e.target.closest("button[data-step]");
    if (btn) {
      setBurger(btn.closest("[data-stepper]").dataset.stepper, Number(btn.dataset.step));
      return;
    }
    // Tocar (o clickear) la fila muestra u oculta la foto.
    const item = e.target.closest(".item");
    if (!item) return;
    const wasOpen = item.classList.contains("show-photo");
    menuEl.querySelectorAll(".item.show-photo").forEach((el) => el.classList.remove("show-photo"));
    if (!wasOpen) item.classList.add("show-photo");
  });

  $("#fries-picker").addEventListener("change", (e) => {
    const r = e.target.closest('input[type="radio"]');
    if (!r) return;
    const m = r.name.match(/^cb-(.+)-(\d+)$/);
    if (m) setCB(m[1], Number(m[2]), r.value === "si");
  });
  document.querySelectorAll('input[name="fries-add"]').forEach((r) => {
    r.addEventListener("change", () => {
      state.friesOn = r.value === "si";
      if (!state.friesOn) state.cheddarBacon = {};
      render();
    });
  });

  $("#meat-picker").addEventListener("click", (e) => {
    const btn = e.target.closest("button[data-meat-step]");
    if (!btn) return;
    setMeat(btn.dataset.meatFor, Number(btn.dataset.meatIdx), Number(btn.dataset.meatStep));
  });
  document.querySelectorAll('input[name="meat-add"]').forEach((r) => {
    r.addEventListener("change", () => {
      state.meatOn = r.value === "si";
      if (!state.meatOn) state.extraCarne = {};
      render();
    });
  });

  document.querySelectorAll('input[name="pay"]').forEach((r) => {
    r.addEventListener("change", () => { state.pay = r.value; render(); });
  });

  function unitName(b, arrLen, i) {
    return arrLen > 1 ? `${b.name} #${i + 1}` : b.name;
  }

  function orderLines() {
    const lines = [];
    CONFIG.burgers.forEach((b) => {
      if (state.qty[b.id] > 0) lines.push(`${state.qty[b.id]}x ${b.name}`);
    });

    const cbLines = [];
    CONFIG.burgers.forEach((b) => {
      const a = state.cheddarBacon[b.id];
      if (!Array.isArray(a)) return;
      a.forEach((on, i) => { if (on) cbLines.push(`  - ${unitName(b, a.length, i)}`); });
    });
    if (cbLines.length) {
      lines.push("Papas con cheddar y bacon:");
      lines.push(...cbLines);
    }

    const meatLines = [];
    CONFIG.burgers.forEach((b) => {
      const a = state.extraCarne[b.id];
      if (!Array.isArray(a)) return;
      a.forEach((n, i) => {
        if (n > 0) meatLines.push(`  - ${unitName(b, a.length, i)}: +${n} medallón${n > 1 ? "es" : ""}`);
      });
    });
    if (meatLines.length) {
      lines.push("Extra de carne:");
      lines.push(...meatLines);
    }
    return lines;
  }

  function waLink() {
    const items = orderLines();
    if (!items.length) return null;
    const msg = [
      "Hola, quiero hacer un pedido:",
      "",
      ...items,
      "",
      `Pago: ${state.pay}`,
      `Total según la web: ${money(total())}`,
    ].join("\n");
    return `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(msg)}`;
  }

  function lineRow(key, qty, label, amount) {
    const flash = flashId === key ? " line--flash" : "";
    return `<div class="line${flash}"><span class="line__qty">${qty}</span><span>${label}</span><span>${money(amount)}</span></div>`;
  }

  function render() {
    CONFIG.burgers.forEach((b) => {
      const st = menuEl.querySelector(`[data-stepper="${b.id}"]`);
      const q = state.qty[b.id];
      st.querySelector("output").textContent = q;
      st.dataset.active = q > 0;
      st.querySelector('[data-step="-1"]').disabled = q === 0;
      menuEl.querySelector(`[data-item="${b.id}"]`).classList.toggle("is-added", q > 0);
    });

    // ---- Cheddar y bacon en las papas (por unidad) ----
    $("#fries-price").textContent = money(friesUnit()) + " c/u";
    document.querySelector('input[name="fries-add"][value="si"]').checked = state.friesOn;
    document.querySelector('input[name="fries-add"][value="no"]').checked = !state.friesOn;
    const fpicker = $("#fries-picker");
    fpicker.hidden = !state.friesOn;
    if (state.friesOn) {
      const inCart = CONFIG.burgers.filter((b) => state.qty[b.id] > 0);
      if (!inCart.length) {
        fpicker.innerHTML = `<p class="meat-empty">Primero sumá hamburguesas arriba y elegí a cuáles ponerles cheddar y bacon.</p>`;
      } else {
        fpicker.innerHTML = inCart.map((b) => {
          const a = cbArr(b.id);
          return a.map((on, i) => {
            const label = a.length > 1
              ? `${b.name} <span class="meat-row__n">#${i + 1}</span>`
              : b.name;
            const nm = `cb-${b.id}-${i}`;
            return `<div class="meat-row">
              <span>${label}</span>
              <div class="choice" role="radiogroup" aria-label="Cheddar y bacon en las papas de ${b.name} unidad ${i + 1}">
                <label><input type="radio" name="${nm}" value="no" ${on ? "" : "checked"} /><span>No</span></label>
                <label><input type="radio" name="${nm}" value="si" ${on ? "checked" : ""} /><span>Sí</span></label>
              </div>
            </div>`;
          }).join("");
        }).join("");
      }
    } else {
      fpicker.innerHTML = "";
    }

    // ---- Extra carne ----
    $("#meat-price").textContent = money(meatUnit()) + " c/u";
    document.querySelector('input[name="meat-add"][value="si"]').checked = state.meatOn;
    document.querySelector('input[name="meat-add"][value="no"]').checked = !state.meatOn;
    const picker = $("#meat-picker");
    picker.hidden = !state.meatOn;
    if (state.meatOn) {
      const inCart = CONFIG.burgers.filter((b) => state.qty[b.id] > 0);
      if (!inCart.length) {
        picker.innerHTML = `<p class="meat-empty">Primero sumá hamburguesas arriba y elegí a cuáles agregarles carne.</p>`;
      } else {
        picker.innerHTML = inCart.map((b) => {
          const a = meatArr(b.id);
          return a.map((n, i) => {
            const label = a.length > 1
              ? `${b.name} <span class="meat-row__n">#${i + 1}</span>`
              : b.name;
            return `<div class="meat-row">
              <span>${label}</span>
              <div class="stepper" data-active="${n > 0}">
                <button type="button" data-meat-step="-1" data-meat-for="${b.id}" data-meat-idx="${i}" aria-label="Quitar medallón extra en ${b.name} unidad ${i + 1}" ${n === 0 ? "disabled" : ""}>−</button>
                <output aria-live="polite">${n}</output>
                <button type="button" data-meat-step="1" data-meat-for="${b.id}" data-meat-idx="${i}" aria-label="Agregar medallón extra en ${b.name} unidad ${i + 1}">+</button>
              </div>
            </div>`;
          }).join("");
        }).join("");
      }
    } else {
      picker.innerHTML = "";
    }

    const rows = [];
    CONFIG.burgers.forEach((b) => {
      if (state.qty[b.id] > 0) rows.push(lineRow(b.id, state.qty[b.id], b.name, state.qty[b.id] * b.price));
    });
    CONFIG.burgers.forEach((b) => {
      const a = state.cheddarBacon[b.id];
      if (!Array.isArray(a)) return;
      a.forEach((on, i) => {
        if (on) rows.push(lineRow("cb-" + b.id + "-" + i, 1, "Cheddar y bacon · " + unitName(b, a.length, i), friesUnit()));
      });
    });
    CONFIG.burgers.forEach((b) => {
      const a = state.extraCarne[b.id];
      if (!Array.isArray(a)) return;
      a.forEach((n, i) => {
        if (n > 0) rows.push(lineRow("meat-" + b.id + "-" + i, n, "Extra carne · " + unitName(b, a.length, i), n * meatUnit()));
      });
    });

    const linesEl = $("#ticket-lines");
    if (!rows.length) {
      linesEl.innerHTML = `<p class="ticket__empty">Tu carrito está vacío. Sumá hamburguesas y aparecen acá.</p>`;
    } else {
      const count = burgerCount();
      linesEl.innerHTML = rows.join("") +
        `<div class="line line--sub"><span>${count} ${count === 1 ? "hamburguesa" : "hamburguesas"} con papas</span><span>${money(total())}</span></div>`;
    }
    flashId = null;

    $("#pay-note").textContent = state.pay === "transferencia"
      ? "Te pasamos el alias por WhatsApp cuando confirmes el pedido."
      : "Pagás cuando te llega el pedido.";

    $("#total").textContent = money(total());
    $("#bar-total").textContent = money(total());

    const link = waLink();
    const wa = $("#wa");
    const barWa = $("#bar-wa");
    if (link) {
      wa.href = link; wa.setAttribute("aria-disabled", "false"); wa.target = "_blank"; wa.rel = "noopener";
      barWa.href = link; barWa.target = "_blank"; barWa.rel = "noopener";
      $("#wa-hint").textContent = "Se abre WhatsApp con el pedido escrito";
    } else {
      wa.href = "#"; wa.setAttribute("aria-disabled", "true"); wa.removeAttribute("target");
      barWa.href = "#";
      $("#wa-hint").textContent = "Sumá al menos una hamburguesa";
    }

    const bar = $("#mobile-bar");
    const show = total() > 0;
    bar.classList.toggle("show", show);
    bar.setAttribute("aria-hidden", String(!show));
    document.body.classList.toggle("has-bar", show);

    persist();
  }

  $("#wa").addEventListener("click", (e) => {
    if ($("#wa").getAttribute("aria-disabled") === "true") {
      e.preventDefault();
      $("#comanda").scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
    }
  });

  document.querySelector(`input[name="pay"][value="${state.pay}"]`).checked = true;
  $("#foot-wa").href = `https://wa.me/${CONFIG.whatsapp}`;

  render();
</script>

<!--
  ============================================================
  FOTO DE FONDO DEL HERO
  Hoy el fondo es una hamburguesa dibujada (SVG) tenue.
  Para usar una foto real:
  1) Pasámela y la incrusto como data URI dentro de este archivo.
  2) En .hero__bg reemplazá el <svg> por:
     <img src="data:image/jpeg;base64,...." alt="" />
     y en el CSS de .hero__bg subí la opacity (ej. 1) y quitá el color.
  ============================================================
